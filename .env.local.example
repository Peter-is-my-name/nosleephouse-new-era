# ── /reklama funnel — environment variables ────────────────────────────────
# Copy this file to `.env.local` for local dev, and set the same values in the
# Vercel project's Settings → Environment Variables for production.
# Everything degrades gracefully when unset (form still submits, Pixel still
# fires) — but leads won't be emailed and server-side CAPI is skipped.

# Resend API key — sends lead emails. Get it at https://resend.com/api-keys
# (reuse the SAME key already on the old nosleephouse.cz Vercel project).
RESEND_API_KEY=

# Optional: override the inbox that receives lead notifications.
# Defaults to nosleephouse@gmail.com
# CONTACT_TO=nosleephouse@gmail.com

# Meta Pixel + Conversions API (dataset: nsh). The Pixel ID is public and has a
# safe default baked in; you only need the CAPI access token as a secret.
NEXT_PUBLIC_META_PIXEL_ID=2270214106762719
META_CAPI_ACCESS_TOKEN=

# ⚠️ Leave UNSET in production. When set, conversion events route to Meta's
# Test Events tab and DO NOT count toward ad delivery. For debugging only.
# META_CAPI_TEST_EVENT_CODE=
